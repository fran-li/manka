    {
      "name": "3. Recomendaciones",
      "item": [
        {
          "name": "3.1 Recomendaciones Pollo + Arroz — 30 min",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "",
                  "pm.test('[3.1] Recomendaciones responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[3.1] Todos los platos cumplen <= 30 min', function () {",
                  "    data.forEach(x => pm.expect(x.tiempoPreparacion).to.be.at.most(30));",
                  "});",
                  "",
                  "pm.test('[3.1] No se incluyen platos con coverage 0%', function () {",
                  "    data.forEach(x => {",
                  "        pm.expect(x.matchedIngredients).to.be.above(0);",
                  "        pm.expect(x.ingredientCoveragePercent).to.be.above(0);",
                  "    });",
                  "});",
                  "",
                  "pm.test('[3.1] Ranking ordenado de mayor a menor score', function () {",
                  "    for (let i = 1; i < data.length; i++) {",
                  "        pm.expect(data[i - 1].score).to.be.at.least(data[i].score);",
                  "    }",
                  "});",
                  "",
                  "pm.test('[3.1] Chaufa queda recomendado con 2/6 ingredientes', function () {",
                  "    const chaufa = data.find(x => x.platoId === 1);",
                  "    pm.expect(chaufa).to.exist;",
                  "    pm.expect(chaufa.matchedIngredients).to.eql(2);",
                  "    pm.expect(chaufa.totalIngredients).to.eql(6);",
                  "    pm.expect(chaufa.ingredientCoveragePercent).to.eql(33.33);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "recommendations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredientIds\": [1, 4],\n  \"availableMinutes\": 30,\n  \"limit\": 10\n}"
            }
          }
        },
        {
          "name": "3.2 Recomendaciones Pollo + Arroz — 60 min",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
