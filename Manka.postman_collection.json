                  "pm.test('[3.2] Recomendaciones responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[3.2] Todos los platos cumplen <= 60 min y coverage > 0', function () {",
                  "    data.forEach(x => {",
                  "        pm.expect(x.tiempoPreparacion).to.be.at.most(60);",
                  "        pm.expect(x.matchedIngredients).to.be.above(0);",
                  "    });",
                  "});",
                  "",
                  "pm.test('[3.2] Con 60 min aparece al menos un plato de 60 min', function () {",
                  "    pm.expect(data.some(x => x.tiempoPreparacion === 60)).to.be.true;",
                  "});",
                  "",
                  "pm.test('[3.2] Se guarda score inicial del chaufa para comparar después del historial', function () {",
                  "    const chaufa = data.find(x => x.platoId === 1);",
                  "    pm.expect(chaufa).to.exist;",
                  "    pm.collectionVariables.set('initialChaufaScore60', String(chaufa.score));",
                  "});"
                ]
