      "name": "1. Ingredientes",
      "item": [
        {
          "name": "1.1 Listar ingredientes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[1.1] Listado responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[1.1] data.sql cargó el catálogo esperado', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.length).to.be.at.least(42);",
                  "    pm.expect(data.some(x => x.id === 1 && x.nombre === 'Pollo')).to.be.true;",
                  "    pm.expect(data.some(x => x.id === 4 && x.nombre === 'Arroz')).to.be.true;",
                  "});",
                  "",
                  "pm.test('[1.1] Existe jerarquía Pollo -> Pechuga/Pierna', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.some(x => x.nombre === 'Pechuga de pollo' && x.parentId === 1)).to.be.true;",
                  "    pm.expect(data.some(x => x.nombre === 'Pierna de pollo' && x.parentId === 1)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
